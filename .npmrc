# Configuración de pnpm orientada a seguridad de la cadena de suministro.
#
# Este proyecto usa pnpm (ver `packageManager` en package.json y pnpm-lock.yaml).
# pnpm ya bloquea por defecto los scripts de instalación (postinstall) de las
# dependencias: solo se ejecutan los declarados en `pnpm.onlyBuiltDependencies`.
# https://pnpm.io/npmrc

# No resuelve versiones publicadas hace menos de 1 día (1440 minutos).
# Un compromiso de mantenedor suele detectarse y despublicarse en horas, así que
# este retraso actúa como red de seguridad frente a ataques de cadena de suministro.
minimumReleaseAge=1440

# Comprueba la integridad de cada paquete del store contra el lockfile.
verify-store-integrity=true
